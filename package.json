{
  "name": "escapement",
  "version": "0.3.0",
  "private": true,
  "description": "An open-source, browser-based timegrapher and accuracy log for mechanical watches.",
  "type": "module",
  "license": "MIT",
  "author": "Charl Fourie",
  "keywords": [
    "watch",
    "timegrapher",
    "horology",
    "web-audio",
    "audioworklet"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "analyze-clip": "tsx scripts/analyze-clip.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
